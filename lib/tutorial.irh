/* TUTORIAL.IRH -- the guided-tutorial scenario.

     The Tutorial Guide effect below is the scenario resource for the
   guided tutorial: its resource variables hold the walkthrough's state
   (saved with the game in the module data segment), and its META()
   event handlers are the walkthrough's triggers.

     The engine installs one TRAP_EVENT stati on the tutorial character
   for every META() handler declared here -- see InstallTutorialGuide()
   in src/Main.cpp, which mirrors Magic::Override. To add a new beat,
   add a variable, add an On Event META(...) block, and nothing else;
   the C++ side discovers the handler from the annotations.

     Every handler returns NOTHING: the guide observes play, it must
   never swallow an event from the engine's own handlers.

     The narrator is Hadric, a dead caravan guard from the Entry
   Chamber's mass grave. His voice, and the review cycle every line
   of this text must pass, are specified in
   docs/superpowers/specs/2026-08-22-tutorial-voice.md. */

Effect "Tutorial Guide" : EA_OVERRIDE
  {
    int16 tGoal, tMove, tStrike, tHurt, tLowHP,
          tPickup, tWield, tRest, tDescend, tKill;

    Flags: EF_PERSISTANT;

    /* Game-rounds tick (once per 60 game ticks). Used once, early, to
       state the goal after the player has had a moment to look around. */
    On Event META(EV_TURN) {
      if (tGoal)
        return NOTHING;
      tGoal = 1;
      EActor->IPrint("<13>Hadric:<7> The king you want is ten floors down,
        and he can wait; nothing in these caves hurries but the dying.
        Circle this chamber first. Eight potions lie among my neighbors --
        five of healing, three of dimension door, which is a soldier's
        word for elsewhere. We carried them down and never carried them
        up, so they are yours.");
      return NOTHING;
      };

    On Event META(POST(EV_MOVE)) {
      if (tMove)
        return NOTHING;
      tMove = 1;
      EActor->IPrint("<13>Hadric:<7> The caves go on farther than your
        torch does. The map keeps everything you have seen -- trust it
        over your memory. Mine failed me at the worst hour it could.");
      return NOTHING;
      };

    On Event META(POST(EV_STRIKE)) {
      if (tStrike)
        return NOTHING;
      tStrike = 1;
      EActor->IPrint("<13>Hadric:<7> Struck. Keep stepping into it until
        one of you stops. And before you trade blows with a stranger,
        press <9>[l]<7> and read it. The things that killed us had their
        habits written plain, for anyone who looked.");
      return NOTHING;
      };

    On Event META(POST(EV_DEATH)) {
      if (tKill || !EVictim || EVictim->isPlayer())
        return NOTHING;
      tKill = 1;
      EActor->IPrint("<13>Hadric:<7> The first one I dropped, I stood over
        too long; count it and move. Kills are the coin that buys levels
        -- a thousand experience buys your second, and no floor is
        stingier than this one. If a thing outmatches you -- a Skeletal
        Warrior, say -- leave it standing. I didn't.");
      return NOTHING;
      };

    On Event META(EVICTIM(POST(EV_DAMAGE))) {
      if (!tHurt) {
        tHurt = 1;
        EVictim->IPrint("<13>Hadric:<7> You're bleeding. Hit points, on
          the status line; when they run out you lie down with the rest
          of us. Put a corridor between you and the thing that did it.
          The dead were braver.");
        return NOTHING;
        }
      if (!tLowHP && (EVictim->cHP * 3 < EVictim->mHP)) {
        tLowHP = 1;
        EVictim->IPrint("<13>Hadric:<7> <4>Enough.<7> Break off. Find a
          corner the dead have already cleared and press <9>[Z]<7> to
          sleep the blood back. Pride will not clot.");
        }
      return NOTHING;
      };

    On Event META(POST(EV_PICKUP)) {
      if (tPickup)
        return NOTHING;
      tPickup = 1;
      EActor->IPrint("<13>Hadric:<7> Take everything; the owners have
        stopped minding. <9>[I]<7> opens your pack -- wear what fits and
        wield what bites; the rest stays in the pack until you can name
        it. <9>[G]<7> takes whatever you stand over.");
      return NOTHING;
      };

    On Event META(POST(EV_WIELD)) {
      if (tWield)
        return NOTHING;
      tWield = 1;
      EActor->IPrint("<13>Hadric:<7> Steel forward, and wear what you
        carry -- my shield rode my back for twenty years and my last
        hour. You were drilled to the long sword; weigh anything
        'better' in the pack screen, not mid-fight.");
      return NOTHING;
      };

    On Event META(POST(EV_REST)) {
      if (tRest)
        return NOTHING;
      tRest = 1;
      EActor->IPrint("<13>Hadric:<7> Sleep before you need it; I put it
        off one corridor too many. Rest costs hours, and things walk
        while you dream, so bed down behind cleared ground -- or climb
        the entry stairs to the inn above, where nothing follows.");
      return NOTHING;
      };

    On Event META(POST(EV_DESCEND)) {
      if (tDescend)
        return NOTHING;
      tDescend = 1;
      EActor->IPrint("<13>Hadric:<7> The stairs, then. Past here I do not
        go; I never learned what the second floor keeps, and I am
        content. Every level down is meaner than the last. Walk wide of
        rooms with a circle at their center -- what stands in those is
        caged, mostly, and profitless either way. And recruit -- come
        back up. One of us should.");
      return NOTHING;
      };
  }

/* Arc 2, Eyes Open: Perrin Underbough, halfling burglar. Script:
   docs/superpowers/specs/2026-08-22-tutorial-scripts.md. */
Effect "Tutorial Guide II" : EA_OVERRIDE
  {
    int16 tLook, tHide, tTrap, tLock, tUnknown,
          tEscape, tRest, tHearth, tInn, tFarewell;

    Flags: EF_PERSISTANT;

    On Event META(POST(EV_STRIKE)) {
      if (tLook)
        return NOTHING;
      tLook = 1;
      EActor->IPrint("<13>Perrin:<7> Before your next swing, press
        <9>[l]<7> and read what you are swinging at. Some things down
        here drain the strength from your arms; some carry disease in
        their teeth. The monster you read is half fought -- another of
        our sayings, and truer than most.");
      return NOTHING;
      };

    /* The hide toggle throws no event; watch the stati instead. The
       unidentified-item beat shares the tick. */
    On Event META(EV_TURN) {
      hObj it;
      if (!tHide && EActor->HasStati(HIDING)) {
        tHide = 1;
        EActor->IPrint("<13>Perrin:<7> Press <9>[h]<7> and the caves
          forget you are in them. Hiding works with any amount of
          skill, though skill keeps it working. A thing that has not
          seen you takes your first blow flat-footed, and flat-footed
          is how I liked them.");
        return NOTHING;
        }
      if (!tUnknown)
        for (it=EActor->FirstInv();it;it=EActor->NextInv())
          if (!it->isKnown(KN_IDENTIFIED)) {
            tUnknown = 1;
            EActor->IPrint("<13>Perrin:<7> You are carrying something
              you cannot name. Appraise before you spend, my mother
              said. When one kind of scroll stacks four or five deep,
              it is near-certain to be Identify; press <9>[r]<7> and
              read one over the rest. Even clumsy eyes manage that
              read half the time.");
            return NOTHING;
            }
      return NOTHING;
      };

    /* A sprung trap surfaces only as its EV_EFFECT; the trap object
       rides the event's item slot, which keeps this beat quiet for
       every other effect. */
    On Event META(POST(EV_EFFECT)) {
      if (tTrap || !EItem || !EItem->isType(T_TRAP))
        return NOTHING;
      tTrap = 1;
      EActor->IPrint("<13>Perrin:<7> That was a trap, and you found it
        the expensive way. Press <9>[s]<7> to search the ground ahead
        when a floor looks too clean. And if you smell kobolds --
        their warrens are floored with traps wall to wall. Stay out
        until your Search skill is worth the rent.");
      return NOTHING;
      };

    On Event META(EV_PICKLOCK) {
      if (tLock)
        return NOTHING;
      tLock = 1;
      EActor->IPrint("<13>Perrin:<7> A hundred XP for a lock that never
        swung at you. Picks and disarmed traps can carry you a level,
        and a second, and a third, while the brave are still bleeding
        for theirs. My uncle Tobbin called it burglar's rent, paid out
        by the door.");
      return NOTHING;
      };

    On Event META(EVICTIM(POST(EV_DAMAGE))) {
      if (tEscape || (EVictim->cHP * 3 >= EVictim->mHP))
        return NOTHING;
      tEscape = 1;
      EVictim->IPrint("<13>Perrin:<7> <4>You are near the floor.<7>
        Healing swallowed mid-fight buys you a round; a potion of
        dimension door buys you a different room. At the brink, drink
        the door. Three of them were laid around the chamber where you
        started.");
      return NOTHING;
      };

    On Event META(POST(EV_REST)) {
      if (tRest)
        return NOTHING;
      tRest = 1;
      EActor->IPrint("<13>Perrin:<7> Sleep is where this floor eats
        people. I know. Rest with your back to a cleared corner, never
        in a corridor, and if an ally or a beast walks with you, they
        will stand watches over your sleep. A neutral, asked kindly,
        might too.");
      return NOTHING;
      };

    On Event META(POST(EV_ACTIVATE)) {
      if (tHearth || !EItem || EItem->ieID != $"hearthstone of onanda")
        return NOTHING;
      tHearth = 1;
      EActor->IPrint("<13>Perrin:<7> A Hearthstone of Onanda -- a
        night's worth of home, we call them. Crumble one and nothing
        touches you before morning. Halflings begin with a pocketful
        and no more come after, so break them on the nights that
        matter.");
      return NOTHING;
      };

    On Event META(POST(EV_ASCEND)) {
      if (tInn)
        return NOTHING;
      tInn = 1;
      EActor->IPrint("<13>Perrin:<7> Past the top of these stairs
        stands the inn, and an inn bed is as safe as sleep gets in
        this country. When your hearthstones run thin and the floor
        below has been unkind, climb up and take the night. The
        dungeon keeps.");
      return NOTHING;
      };

    On Event META(POST(EV_DESCEND)) {
      if (tFarewell)
        return NOTHING;
      tFarewell = 1;
      EActor->IPrint("<13>Perrin:<7> The stairs are as far as I go; the
        corridor that kept me is on this floor, and I mind it still.
        Walk soft, and count your stones before you sleep. If we never
        meet again, that means it worked.");
      return NOTHING;
      };
  }

/* Arc 3, At Range: Sylvassi, elf archer. */
Effect "Tutorial Guide III" : EA_OVERRIDE
  {
    int16 tSlots, tFire, tShot, tMiss, tAmmoLow,
          tSwapMelee, tKite, tSpecial, tCompanion, tFarewell;

    Flags: EF_PERSISTANT;

    /* The first two beats pace themselves on the game-rounds tick;
       the ammo count and the slow-hostile watch share it. */
    On Event META(EV_TURN) {
      hObj it; int16 n;
      if (!tSlots) {
        tSlots = 1;
        EActor->IPrint("<13>Sylvassi:<7> Open your pack with <9>[I]<7>.
          Set the bow with <9>[R]<7>, arrows with <9>[A]<7>, a blade
          with <9>[M]<7>, shield or second blade with <9>[O]<7>. A
          slot takes nothing that stays in the pack. What is slotted
          answers the hand; the rest is baggage.");
        return NOTHING;
        }
      if (!tFire) {
        tFire = 1;
        EActor->IPrint("<13>Sylvassi:<7> Hold Shift and press a
          direction: the bow speaks down that line. For a moving mark,
          press <9>[f]<7> and choose it.");
        return NOTHING;
        }
      if (!tAmmoLow && tShot) {
        n = 0;
        for (it=EActor->FirstInv();it;it=EActor->NextInv())
          if (it->isType(T_MISSILE))
            n += it->GetQuantity();
        if (n < 10) {
          tAmmoLow = 1;
          EActor->IPrint("<13>Sylvassi:<7> Your quiver runs light.
            Gather every arrow the floor offers, and walk wide of
            trouble until it fills.");
          return NOTHING;
          }
        }
      if (!tKite) {
        for (it=EMap->FirstThing();it;it=EMap->NextThing())
          if (it->isCreature() && it != EActor &&
              it->isHostileTo(EActor) &&
              (EActor->Perceives(it) & PER_VISUAL) &&
              it->mID != NULL_ID && EActor->mID != NULL_ID &&
              (it->mID->Mov < EActor->mID->Mov)) {
            tKite = 1;
            EActor->IPrint("<13>Sylvassi:<7> That one is slower than
              you. Walk back one pace, loose, walk back again. It will
              die without once arriving.");
            return NOTHING;
            }
        }
      return NOTHING;
      };

    On Event META(POST(EV_RATTACK)) {
      if (tShot)
        return NOTHING;
      tShot = 1;
      EActor->IPrint("<13>Sylvassi:<7> Loosed. Now step back and loose
        again. The bow's whole argument is the ground between you.");
      return NOTHING;
      };

    On Event META(POST(EV_MISS)) {
      if (tMiss || !EItem)
        return NOTHING;
      if (!EItem->isType(T_BOW) && !EItem->isType(T_MISSILE))
        return NOTHING;
      tMiss = 1;
      EActor->IPrint("<13>Sylvassi:<7> A miss spends the arrow all the
        same. Count what rides in your quiver before you pick a
        quarrel at forty paces.");
      return NOTHING;
      };

    On Event META(POST(EV_STRIKE)) {
      if (tSwapMelee)
        return NOTHING;
      tSwapMelee = 1;
      EActor->IPrint("<13>Sylvassi:<7> So you let the argument get
        close. Press <9>[-]<7> to trade the bow for the blade, and
        press it again once you have made room to shoot.");
      return NOTHING;
      };

    On Event META(EVICTIM(POST(EV_DAMAGE))) {
      if (tSpecial)
        return NOTHING;
      tSpecial = 1;
      EVictim->IPrint("<13>Sylvassi:<7> It touched you. Press <9>[l]<7>
        before you close with anything new; some of what walks here
        drains and sickens at arm's length. Arm's length is the one
        range I refused them -- except once.");
      return NOTHING;
      };

    On Event META(POST(EV_REST)) {
      hObj it;
      if (tCompanion)
        return NOTHING;
      for (it=EMap->FirstThing();it;it=EMap->NextThing())
        if (it->isCreature() && it != EActor &&
            it->getLeader() == EActor) {
          tCompanion = 1;
          EActor->IPrint("<13>Sylvassi:<7> The beast beside you keeps
            watch while you sleep; that is worth more than its teeth.
            Press <9>[t]<7> to speak with it -- it will follow you, or
            take a mark.");
          return NOTHING;
          }
      return NOTHING;
      };

    On Event META(POST(EV_DESCEND)) {
      if (tFarewell)
        return NOTHING;
      tFarewell = 1;
      EActor->IPrint("<13>Sylvassi:<7> I stop here. Below, the
        corridors shorten and the dark stands closer; hold your twelve
        paces where the map allows fewer. Waste nothing.");
      return NOTHING;
      };
  }

/* Arc 4, First Spells: Maro Venn, mage. Casting beats key off a shared
   counter, so the first and second casts read differently. */
Effect "Tutorial Guide IV" : EA_OVERRIDE
  {
    int16 tCasts, tBuffMark, tMacro, tMeleeCast,
          tHurt, tLowMana, tRest, tBook, tStairs;

    Flags: EF_PERSISTANT;

    On Event META(POST(EV_CAST)) {
      if (tCasts < 2) {
        tCasts = tCasts + 1;
        if (tCasts == 1)
          EActor->IPrint("<13>Maro Venn:<7> That casting was paid for
            in mana. Watch the meter: green mana returns when you
            rest; brown is pledged to a spell that persists, and stays
            pledged until you drop the working. A mage's ledger has
            two columns. Mine balanced one day too late.");
        else
          EActor->IPrint("<13>Maro Venn:<7> Twice now you have walked
            the whole menu. In the spell list, press <9>[0]<7> through
            <9>[9]<7> on a spell to bind it; the digit alone then
            casts it, with no menu between you and the foe. Ten keys
            -- nine, if a use-verb has claimed one. They share the
            pool.");
        return NOTHING;
        }
      if (!tBuffMark && (e.eID->Purpose & EP_BUFF)) {
        tBuffMark = 1;
        EActor->IPrint("<13>Maro Venn:<7> A persistent spell wants
          recasting every morning, and mornings multiply. In the spell
          list, press <9>[F5]<7> on each buff to mark it; outside the
          list, <9>[F5]<7> casts the whole marked slate at once. I
          marked mine the week I died -- the week before. The habit
          outlived me.");
        return NOTHING;
        }
      if (!tMeleeCast && EActor->isThreatened()) {
        tMeleeCast = 1;
        EActor->IPrint("<13>Maro Venn:<7> Step back before you shape
          the next one. Every enemy in reach taxes the casting through
          your Concentration skill; fail that check and the mana is
          spent on nothing. The step costs you nothing. The spell
          costs mana either way.");
        }
      return NOTHING;
      };

    On Event META(POST(EV_MACRO)) {
      if (tMacro)
        return NOTHING;
      tMacro = 1;
      EActor->IPrint("<13>Maro Venn:<7> The slate is cast. Do this
        after every rest, once your spells have lapsed. An unbuffed
        mage is a scribe in a knife-fight, and the dungeon does not
        read.");
      return NOTHING;
      };

    On Event META(EVICTIM(POST(EV_DAMAGE))) {
      if (tHurt)
        return NOTHING;
      tHurt = 1;
      EVictim->IPrint("<13>Maro Venn:<7> Wounds break spells the same
        way blades do -- damage forces a Concentration check on
        anything you are casting. Put ranks in that skill and keep it
        high. Your hide is thin vellum; write on it as little as
        possible.");
      return NOTHING;
      };

    On Event META(EV_TURN) {
      if (tLowMana || (EActor->cMana() * 3 >= EActor->tMana()))
        return NOTHING;
      tLowMana = 1;
      EActor->IPrint("<13>Maro Venn:<7> <4>Your mana runs low.<7> Stop
        spending. An empty mage is prey, and prey that glows. I
        counted four points left -- three, in truth -- and priced my
        last spell wrong. Withdraw and rest, or drink a potion of mana
        if your kit holds one.");
      return NOTHING;
      };

    On Event META(POST(EV_REST)) {
      if (tRest)
        return NOTHING;
      tRest = 1;
      EActor->IPrint("<13>Maro Venn:<7> Rest is repayment. Sleep
        restores green mana in full and renews your lapsed spells for
        the day. It repays nothing in the brown column -- press
        <9>[x]<7> to drop a persistent working first, if you want that
        mana back before you lie down.");
      return NOTHING;
      };

    On Event META(POST(EV_PICKUP)) {
      if (tBook || !EItem || !EItem->isType(T_BOOK))
        return NOTHING;
      tBook = 1;
      EActor->IPrint("<13>Maro Venn:<7> A spellbook. The better part of
        a mage's craft is found, not granted, and the finding of books
        is your true career -- Luck the finder's fee. Read it with
        <9>[r]<7>, and read it to the end. The answer to my death was
        three pages past my bookmark.");
      return NOTHING;
      };

    On Event META(POST(EV_DESCEND)) {
      if (tStairs)
        return NOTHING;
      tStairs = 1;
      EActor->IPrint("<13>Maro Venn:<7> The stair. I go no further; my
        binding is exact, even where my counting was not. Below, spend
        mana like the miser it deserves, and keep a reserve of four
        points at all times. Five. Always five.");
      return NOTHING;
      };
  }

/* Arc 5, Faith and Favor: Sister Ilsabet, priest. */
Effect "Tutorial Guide V" : EA_OVERRIDE
  {
    int16 tPray, tSac, tUneasy, tGuilty, tCleric,
          tCurse, tAltar, tInsight, tAid, tStairs;

    Flags: EF_PERSISTANT;

    On Event META(POST(EV_PRAY)) {
      if (tPray)
        return NOTHING;
      tPray = 1;
      EActor->IPrint("<13>Sister Ilsabet:<7> You have prayed. Prayer is
        a withdrawal: aid, insight, blessing, each drawn against your
        favor. Petition when the need is real. A god dunned daily
        grows deaf -- mine did, though the fault in the account was my
        own.");
      return NOTHING;
      };

    On Event META(POST(EV_SACRIFICE)) {
      if (tSac)
        return NOTHING;
      tSac = 1;
      EActor->IPrint("<13>Sister Ilsabet:<7> An offering, and the
        ledger moves. Sacrifice upon your god's altar pays favor in --
        corpses, treasure, whatever that god prizes. Feed the account
        before the day you must draw on it. So it is written, and so I
        learned.");
      return NOTHING;
      };

    /* Divine displeasure, a standing cleric and a known curse have no
       events of their own; the tick watches for all three. The altar
       beat rides it too, keyed to the square underfoot. */
    On Event META(EV_TURN) {
      hObj it;
      if (!tUneasy && EActor->getGod() != NULL_ID &&
          EActor->getGodAnger(EActor->getGod()) > 0) {
        tUneasy = 1;
        EActor->IPrint("<13>Sister Ilsabet:<7> <4>You feel uneasy.<7>
          That is your god's displeasure being entered against you:
          some act of yours broke the terms of service, and the hint
          beside the feeling names the deed. Mark it. Atonement is
          sacrifice, and works the god loves.");
        return NOTHING;
        }
      if (!tCleric) {
        for (it=EMap->FirstThing();it;it=EMap->NextThing())
          if (it->isCreature() && it != EActor && it->getGod() != NULL_ID &&
              it->HasMFlag(M_CASTER) &&
              (EActor->Perceives(it) & PER_VISUAL)) {
            tCleric = 1;
            EActor->IPrint("<13>Sister Ilsabet:<7> A cleric of the
              dungeon stands in view. Any priest sells service spells
              -- healing, cure disease, remove curse -- for coin,
              where Charisma or the Diplomacy skill opens the trade.
              My order sold the same mercies, at the same counter.");
            return NOTHING;
            }
        }
      if (!tCurse) {
        for (it=EActor->FirstInv();it;it=EActor->NextInv())
          if (it->isKnown(KN_CURSE) && it->isCursed()) {
            tCurse = 1;
            EActor->IPrint("<13>Sister Ilsabet:<7> The thing is cursed.
              Carry it to an altar of your own god: laid there
              unequipped, prayer will have it blessed clean. A spell,
              scroll or potion of Remove Curse serves as well, and
              some gods lift curses outright for the faithful whose
              account stands high.");
            return NOTHING;
            }
        }
      if (!tAltar) {
        for (it=EMap->FFeatureAt(EActor->x,EActor->y);it;
             it=EMap->NFeatureAt(EActor->x,EActor->y))
          if (it->fID == $"altar") {
            tAltar = 1;
            EActor->IPrint("<13>Sister Ilsabet:<7> An altar, and its
              sign tells you whose. On your own god's stone you may
              sacrifice and be heard; on a stranger's, conduct
              yourself as a guest. Every altar is a counting-house,
              and every house keeps a different book.");
            return NOTHING;
            }
        }
      return NOTHING;
      };

    On Event META(EV_GUILT) {
      if (tGuilty)
        return NOTHING;
      tGuilty = 1;
      EActor->IPrint("<13>Sister Ilsabet:<7> <4>You feel guilty.<7>
        This debt is not your god's; it is your own. You have acted
        against your stated alignment, and the alignment is shifting
        under you. Conduct is a vow. Keep it, or choose from the
        character screen a creed you can keep.");
      return NOTHING;
      };

    On Event META(POST(EV_INSIGHT)) {
      if (tInsight)
        return NOTHING;
      tInsight = 1;
      EActor->IPrint("<13>Sister Ilsabet:<7> You sought insight -- the
        cheapest line of the litany. The god will speak to your
        standing, or lay open the nature of a thing you carry, as
        Xavias does for those he favors. Ask often. Knowledge is drawn
        at a discount.");
      return NOTHING;
      };

    On Event META(EVICTIM(POST(EV_DAMAGE))) {
      if (tAid || (EVictim->cHP * 3 >= EVictim->mHP))
        return NOTHING;
      tAid = 1;
      EVictim->IPrint("<13>Sister Ilsabet:<7> <4>You are failing.<7>
        Now, if the account is full, press <9>[p]<7> and pray for aid:
        a pleased god mends flesh and strikes at besiegers. If the
        account is empty, the answer is silence. I have heard that
        silence. Arrange never to hear it.");
      return NOTHING;
      };

    On Event META(POST(EV_DESCEND)) {
      if (tStairs)
        return NOTHING;
      tStairs = 1;
      EActor->IPrint("<13>Sister Ilsabet:<7> Here I stop; the stair is
        the edge of my parish. Below, keep the vow, feed the altar,
        and draw no more than you deposit. The god remembers all of
        it, item by item. So it is written, and so I learned.");
      return NOTHING;
      };
  }

/* Arc 6, The Deep Game: the Margins, a dead scholar's journal hand.
   No preset character; the guide narrates the strategic layer over
   whoever the player made. */
Effect "Tutorial Guide VI" : EA_OVERRIDE
  {
    int16 tSelf, tConduct, tTerms, tTalk, tTerrain,
          tFountain, tForge, tCoin, tMulti, tLast;

    Flags: EF_PERSISTANT;

    /* Terrain, fountains, forges and the mid-game level are watched
       from the tick; nothing else announces them. */
    On Event META(EV_TURN) {
      hObj it; rID tID;
      if (!tSelf) {
        tSelf = 1;
        EActor->IPrint("<13>Margins:<7> First entry, underlined twice:
          know the creature one already is. Race and class carry
          abilities that die unused -- the kobold with Flawless Dodge
          who never dodged lies buried by the stair. The dungeon waits
          while a page is read. It always waits.");
        return NOTHING;
        }
      if (!tTerrain) {
        tID = EMap->TerrainAt(EActor->x,EActor->y);
        if (tID != NULL_ID && (ResourceHasFlag(tID,TF_WARN) ||
                    ResourceHasFlag(tID,TF_WATER) ||
                    ResourceHasFlag(tID,TF_FALL))) {
          tTerrain = 1;
          EActor->IPrint("<13>Margins:<7> Terrain kills the incurious.
            The mark <9>[l]<7> laid upon any square tells what it
            costs to stand there, and hazard ground bills once for the
            move and again for every turn spent upon it. The floor was
            read, or the floor was paid.");
          return NOTHING;
          }
        }
      if (!tFountain) {
        for (it=EMap->FirstThing();it;it=EMap->NextThing())
          if (it->isType(T_FOUNTAIN) && it->DistFrom(EActor) <= 1) {
            tFountain = 1;
            EActor->IPrint("<13>Margins:<7> A fountain wagers on Luck:
              one d20 and the drinker's modifier. High water heals
              poison, disease, even curses; drinking is a fair bet for
              the fortunate. Dipping an item is another matter --
              <4>a roll of 1 or 2 raises a wastrilith,<7> a water
              demon of the tenth rank. The scholar's rule: no dipping
              under Luck +2, and a potion of dimension door in hand
              regardless.");
            return NOTHING;
            }
        }
      if (!tForge) {
        for (it=EMap->FFeatureAt(EActor->x,EActor->y);it;
             it=EMap->NFeatureAt(EActor->x,EActor->y))
          if (it->fID == $"forge") {
            tForge = 1;
            EActor->IPrint("<13>Margins:<7> A forge is the only ground
              where metal is made or mended: stand upon it and work
              the Craft skill. The scholar noted that smiths outlive
              swordsmen, and then went below without a hammer.");
            return NOTHING;
            }
        }
      if (!tMulti && EActor->isPlayer() && EActor->TotalLevel() >= 8) {
        tMulti = 1;
        EActor->IPrint("<13>Margins:<7> On multiclassing the margin is
          firm. A class is a trade, and a second trade is taken late:
          a level or two of rogue or monk near the tenth season buys
          evasion, saves, and skills. Before then, depth in one craft
          over breadth in two.");
        }
      return NOTHING;
      };

    On Event META(EV_GUILT) {
      if (tConduct)
        return NOTHING;
      tConduct = 1;
      EActor->IPrint("<13>Margins:<7> Alignment is not a label; it is a
        record of conduct. Each act against the creed shifts the
        needle, and the needle stays honest when the adventurer does
        not. Those who find the accounting tiresome play neutral evil,
        and answer only to the dungeon.");
      return NOTHING;
      };

    On Event META(POST(EV_TALK)) {
      if (GetHandle(ETarget) && !tTerms && ETarget->isCreature() &&
          ETarget->isHostileTo(EActor) && ETarget->HasStati(AFRAID)) {
        tTerms = 1;
        EActor->IPrint("<13>Margins:<7> A fleeing foe that can speak
          can surrender: press <9>[t]<7> and offer terms, and the
          fight closes without stain. What cannot speak cannot yield
          -- cut it down in flight and the guilt is entered all the
          same.");
        return NOTHING;
        }
      if (tTalk)
        return NOTHING;
      tTalk = 1;
      EActor->IPrint("<13>Margins:<7> The scholar rated <9>[t]<7> above
        the sword. Neutrals trade for coin, allies take orders,
        summoned things are commanded by it, and a strong voice
        demoralizes what a strong arm cannot reach. Most of the
        dungeon has ears.");
      return NOTHING;
      };

    On Event META(POST(EV_PICKUP)) {
      if (tCoin || !EItem || EItem->iID != $"gold piece")
        return NOTHING;
      tCoin = 1;
      EActor->IPrint("<13>Margins:<7> Coin is heavy and the store is
        dear, yet the scholar carried gold. Crafting, alchemy,
        scribing and brewing all consume it; neutral denizens sell for
        it; a priest's mercy carries a price in it. Money buys what
        looting cannot schedule.");
      return NOTHING;
      };

    On Event META(POST(EV_DESCEND)) {
      if (tLast || EMap->Depth < 4)
        return NOTHING;
      tLast = 1;
      EActor->IPrint("<13>Margins:<7> The last note in the book,
        deepest page, smallest hand: 'Below this line the maps
        disagree.' Nothing follows it. Margins are written for
        whoever comes after. So was this one.");
      return NOTHING;
      };
  }
